{
  "name": "softdmx-monorepo",
  "private": true,
  "packageManager": "yarn@4.17.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "yarn workspace @softdmx/frontend dev",
    "dev:electron": "yarn workspace @softdmx/client dev",
    "dev": "concurrently -k \"yarn dev:frontend\" \"yarn dev:electron\"",
    "build:frontend": "yarn build:wasm && yarn workspace @softdmx/frontend build",
    "build:electron": "yarn workspace @softdmx/client build",
    "build:wasm": "yarn workspace @softdmx/wasm build:wasm",
    "build": "yarn build:frontend && yarn build:electron",
    "dist:electron": "yarn build && yarn workspace @softdmx/client dist",
    "test": "yarn workspace @softdmx/tests test",
    "test:unit": "yarn workspace @softdmx/tests test:unit",
    "test:property": "yarn workspace @softdmx/tests test:property",
    "test:integration": "yarn workspace @softdmx/tests test:integration",
    "test:e2e": "yarn workspace @softdmx/tests test:e2e",
    "test:fuzz": "yarn workspace @softdmx/tests test:fuzz",
    "test:fuzz:ci": "yarn workspace @softdmx/tests test:fuzz:ci",
    "test:runtime-baseline": "yarn workspace @softdmx/tests test:runtime-baseline",
    "test:runtime-compare": "yarn workspace @softdmx/tests test:runtime-compare",
    "test:playwright": "yarn workspace @softdmx/tests test:playwright",
    "test:playwright:electron": "yarn workspace @softdmx/tests test:playwright:electron",
    "test:coverage": "yarn workspace @softdmx/tests test:coverage",
    "test:all": "yarn test",
    "cli": "node packages/client/scripts/softdmx-cli.mjs",
    "favicon:generate": "yarn workspace @softdmx/frontend favicon:generate",
    "icon:generate": "yarn workspace @softdmx/client icon:generate",
    "clean": "node scripts/clean.mjs",
    "lint": "oxlint packages/frontend packages/engine packages/client packages/shared packages/tests packages/wasm",
    "typecheck": "yarn workspace @softdmx/engine type-check && yarn workspace @softdmx/client type-check && yarn workspace @softdmx/frontend type-check",
    "license:check": "node scripts/find-missing-headers.js",
    "license:fix": "node scripts/add-missing-headers.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.72.0"
  },
  "resolutions": {
    "@xmldom/xmldom": "0.8.15",
    "ajv": "8.18.0",
    "baseline-browser-mapping": "2.11.0",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "brace-expansion@npm:^2.0.1": "2.1.4",
    "brace-expansion@npm:^5.0.2": "5.0.9",
    "brace-expansion@npm:^5.0.5": "5.0.9",
    "browserslist": "4.28.7",
    "engine.io": "6.6.7",
    "fast-uri": "3.1.6",
    "fast-xml-parser": "5.10.1",
    "glob": "10.5.0",
    "immutable": "5.1.8",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.2",
    "lodash": "4.18.0",
    "minimatch@npm:^3.0.4": "3.1.4",
    "minimatch@npm:^3.0.5": "3.1.4",
    "minimatch@npm:^5.0.1": "5.1.8",
    "minimatch@npm:^9.0.3": "9.0.7",
    "minimatch@npm:^9.0.4": "9.0.7",
    "nanoid@npm:^3": "3.3.18",
    "picomatch@npm:^2.3.1": "2.3.2",
    "picomatch@npm:^4.0.2": "4.0.4",
    "postcss": "8.5.23",
    "shell-quote": "1.9.0",
    "socket.io-parser": "4.2.7",
    "tar": "7.5.21",
    "tmp": "0.2.7",
    "undici@npm:^6.25.0": "6.28.0",
    "undici@npm:^7.24.4": "7.29.0",
    "undici@npm:^7.28.0": "7.29.0",
    "ws": "8.21.0",
    "yaml@npm:^2.0.0": "2.8.3",
    "node-gyp@npm:latest": "patch:node-gyp@npm%3A11.2.0#~/.yarn/patches/node-gyp-npm-11.2.0-36aeb0fa50.patch"
  },
  "engines": {
    "node": "22.23.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 4.17.0"
  }
}
